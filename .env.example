# Public canonical origin. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://jewishoriginal.com

# Sanity project ID and dataset name are public configuration.
# The development dataset is private, so published History and Podcast
# reads and authenticated draft preview need the server-only read token.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_READ_TOKEN=
# Required for /api/draft-mode/enable History and Podcast preview.
DRAFT_MODE_SECRET=

# Server-only write token for reviewed editorial migrations and gated ingest.
# Required for full-text draft migration apply. Never commit or expose it.
SANITY_API_WRITE_TOKEN=

# Local review only. Enables /today?preview=calendar-unavailable.
# Do not set this in production.
# JEWISH_TODAY_ALLOW_PREVIEWS=1

# News + Events ingest. Do not commit values. The scheduled production route
# fails closed unless every credential and the explicit write gate are set.
# CRON_SECRET=
# AI_GATEWAY_API_KEY=
# NEWS_AI_MODEL=openai/gpt-4.1-nano
# NEWS_AI_FALLBACK_MODEL=openai/gpt-4o-mini
# NEWS_RELEVANCE_THRESHOLD=0.78
# NEWS_DESK_CONFIDENCE_THRESHOLD=0.72
# INGEST_WRITES_ENABLED=1
