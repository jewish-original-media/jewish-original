# Public canonical origin. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://jewishoriginal.com

# Optional Sanity identifiers used only to query published History entries
# for /today. Jewish Today does not write to Sanity. The development dataset
# is private, so published reads need the server-only read token. Leave these
# blank if History has not been configured in this worktree.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_READ_TOKEN=

# Local review only. Enables /today?preview=calendar-unavailable.
# Do not set this in production.
# JEWISH_TODAY_ALLOW_PREVIEWS=1

# Added by History. Not used on this Integration branch until History is merged.
# DRAFT_MODE_SECRET=

# Provisioned service variables will be documented and added only when the
# corresponding production integration is installed.
