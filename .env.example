# Public canonical origin. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://jewishoriginal.com

# Sanity Free development project. The project ID and dataset name are public
# configuration; the write token must remain server-only and is never committed.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_WRITE_TOKEN=

# Server-only, least-privilege read token used for published History reads
# against the private Sanity dataset and for authenticated draft preview.
# Generate a long random secret for the preview entry route.
SANITY_API_READ_TOKEN=
DRAFT_MODE_SECRET=
