# Public canonical origin. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://jewishoriginal.com

# Sanity project ID and dataset name are public configuration.
# The development dataset is private, so published History reads and
# authenticated draft preview need the server-only read token.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_READ_TOKEN=
DRAFT_MODE_SECRET=

# Server-only write token for local History import/editorial scripts.
# Never commit a value and never expose this to the browser.
SANITY_API_WRITE_TOKEN=

# Local review only. Enables /today?preview=calendar-unavailable.
# Do not set this in production.
# JEWISH_TODAY_ALLOW_PREVIEWS=1

# Provisioned service variables will be documented and added only when the
# corresponding production integration is installed.
